# ---- Firebase web app config (Firebase console → Project settings → Your apps → Web app) ----
# These are public identifiers, safe in the browser. Security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Server-only secrets (used by /api/extract-job-details; never sent to the browser) ----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: better scraping for JavaScript-heavy job sites (https://firecrawl.dev)
FIRECRAWL_API_KEY=
# Optional: override the Gemini model
# GEMINI_MODEL=gemini-3.5-flash-lite
